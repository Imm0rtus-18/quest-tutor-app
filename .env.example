GEMINI_API_KEY=your-api-key-here
PORT=3000
# Optional. Defaults to gemini-2.5-flash. Switch to gemini-2.5-flash-lite
# if you hit daily rate limits on the free tier — lower quality, higher quota.
# GEMINI_MODEL=gemini-2.5-flash-lite

# Required for Nova's "find a video" tool (search_youtube_video). Get a key
# from Google Cloud Console with the YouTube Data API v3 enabled. Without
# this set, the tool call simply returns no video — chat still works fine.
YOUTUBE_API_KEY=your-youtube-data-api-key-here
